NODE_ENV=development
PORT=3000
REDIS_URL=redis://127.0.0.1:6379
# comma-separated name:key pairs. Generate keys with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_KEYS=alice:replace-me-1,bob:replace-me-2
ADMIN_TOKEN=replace-me-admin
# comma-separated allowed origins; empty = no cross-origin access
CORS_ORIGINS=
# set to 1 when behind exactly one reverse proxy (nginx, Render, etc.) so req.ip is correct
TRUST_PROXY=0
# open = allow requests if Redis is down, closed = reject with 503
FAIL_MODE=open
